{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/login.html",
      "dest": "/frontend/login.html"
    },
    {
      "src": "/hotel-detail.html",
      "dest": "/frontend/hotel-detail.html"
    },
    {
      "src": "/favorites.html",
      "dest": "/frontend/favorites.html"
    },
    {
      "src": "/add-hotel.html",
      "dest": "/frontend/add-hotel.html"
    },
    {
      "src": "/my-properties.html",
      "dest": "/frontend/my-properties.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
